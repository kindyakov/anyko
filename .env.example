# Local development only. Keep the real .env out of Git.
PORT=3020
API_PORT=3021
WORKER_PORT=3022
WORKER_QUEUES=ocr,llm,render,maintenance
API_ORIGIN=http://127.0.0.1:3021
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/anyko
TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/anyko_test
# The two flags select one mode: both true (documents and works) or both false (health only).
DOCUMENTS_ENABLED=true
WORKS_ENABLED=true
# Replace with a private 32-byte key written as 64 hex characters; API and worker share it.
LLM_CONFIG_ENCRYPTION_KEY=replace-with-64-hex-characters
AUTH_SECRET=replace-with-a-random-value-at-least-32-characters
AUTH_BASE_URL=http://anyko.localhost:3020
APP_ORIGIN=http://anyko.localhost:3020
LOCAL_USER_EMAIL=developer@anyko.local
LOCAL_USER_PASSWORD=replace-with-a-random-local-password
REDIS_URL=redis://127.0.0.1:16399
S3_ENDPOINT=http://127.0.0.1:19020
S3_BUCKET=anyko-local
S3_ACCESS_KEY=anyko-local
S3_SECRET_KEY=replace-with-a-random-local-storage-key
MINERU_BASE_URL=http://127.0.0.1:8020
# Optional worker limits; the values below are the defaults.
# MINERU_TIMEOUT_MS=240000
# WORKER_HOST=127.0.0.1
# WORKER_CONCURRENCY=2
# Agent work analysis: model calls per step 1-64, reads per step and per final review 1-256.
# ANYKO_ANALYSIS_MAX_MODEL_CALLS=32
# ANYKO_ANALYSIS_MAX_READS=24
# ANYKO_ANALYSIS_REVIEW_MAX_READS=64
# ANYKO_ANALYSIS_STEPWISE=false
# Chat and reconciliation: 1-64 model calls; reconciliation: 1-256 reads.
# ANYKO_MIN_MODEL_CONTEXT_TOKENS=131072
# ANYKO_CHAT_MAX_MODEL_CALLS=8
# ANYKO_RECONCILE_MAX_MODEL_CALLS=12
# ANYKO_RECONCILE_MAX_READS=24
# Vision output budget: 1-16384 tokens.
# ANYKO_VISION_MAX_OUTPUT_TOKENS=4800
