# Local development only. Keep the real .env out of Git.
PORT=3020
API_PORT=3021
WORKER_PORT=3022
API_ORIGIN=http://127.0.0.1:3021
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/anyko
TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/anyko_test
DOCUMENTS_ENABLED=true
# Enable persistent works after migrations. Generate and retain a private 32-byte hex key.
WORKS_ENABLED=false
LLM_CONFIG_ENCRYPTION_KEY=
AUTH_SECRET=replace-with-a-random-value-at-least-32-characters
AUTH_BASE_URL=http://anyko.localhost:3020
APP_ORIGIN=http://anyko.localhost:3020
LOCAL_USER_EMAIL=developer@anyko.local
LOCAL_USER_PASSWORD=replace-with-a-random-local-password
REDIS_URL=redis://127.0.0.1:16399
S3_ENDPOINT=http://127.0.0.1:19020
S3_BUCKET=anyko-local
S3_ACCESS_KEY=anyko-local
S3_SECRET_KEY=replace-with-a-random-local-storage-key
MINERU_BASE_URL=http://127.0.0.1:8020
