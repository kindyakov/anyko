NODE_ENV=development
RELEASE=local
LOG_LEVEL=info
API_HOST=127.0.0.1
API_PORT=3001
SHUTDOWN_TIMEOUT_MS=10000
# Both flags must match: true selects the full mode, false the health-only mode.
DOCUMENTS_ENABLED=true
WORKS_ENABLED=true
# Full mode needs these; put real values in ignored local configuration, not here.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/anyko
# Use the same Redis as the worker for incremental work chat.
REDIS_URL=redis://127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:19020
S3_BUCKET=anyko
S3_ACCESS_KEY=replace-with-a-local-storage-key
S3_SECRET_KEY=replace-with-a-random-local-storage-key
LLM_CONFIG_ENCRYPTION_KEY=replace-with-64-hex-characters
AUTH_SECRET=replace-with-a-random-value-at-least-32-characters
AUTH_BASE_URL=http://anyko.localhost:3020
APP_ORIGIN=http://anyko.localhost:3020
