exports[`bfl-bankruptcy-v12 creditors keeps the reference DOCX text and tables 1`] = `
"Список кредиторов и должников гражданина
<table>
span=11 "Информация о гражданине"
span=4 "фамилия" | span=2 "обязательно" | span=5 "Макетова"
span=4 "имя" | span=2 "обязательно" | span=5 "Елена"
span=4 "отчество" | span=2 "при наличии" | span=5 "Павловна"
