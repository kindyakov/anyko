span=4 "район" | span=2 "при наличии" | span=5 "_____________________________________"
span=4 "город" | span=2 "при наличии" | span=5 "_____________________________________"
span=4 "населенный пункт (село, поселок и так далее)" | span=2 "при наличии" | span=5 "_____________________________________"
