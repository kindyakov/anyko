span=4 "номер квартиры (офиса)" | span=2 "при наличии" | span=5 "_____________________________________"
span=13 "I. Сведения о кредиторах гражданина\\n(по денежным обязательствам и (или) обязанности по уплате обязательных платежей,\\nза исключением возникших в результате осуществления гражданином предпринимательской деятельности)"
"1" | span=12 "Денежные обязательства"
merge=restart "№ п/п" | span=2 merge=restart "Содержание обязательства" | merge=restart "Кредитор " | span=2 merge=restart "Место нахождения (место жительства) кредитора" | span=2 merge=restart "Основание возникновения" | span=3 "Сумма обязательства" | span=2 merge=restart "Штрафы, пени ииные санкции"
merge=continue "" | span=2 merge=continue "" | merge=continue "" | span=2 merge=continue "" | span=2 merge=continue "" | span=2 "всего" | "в том числе задолженность" | span=2 merge=continue ""
"1" | span=2 "Кредит" | "АО «Тестовый Банк»" | span=2 "_____________" | span=2 "по кредитному договору № TEST-87 от 01.03.2025 г. в размере 12 000,50 руб., подтверждение: ______________" | span=2 "12 000,50" | "-" | span=2 "-"
"2" | span=11 "Обязательные платежи"
"№ п/п" | span=4 "Наименование налога, сбора или иного обязательного платежа" | span=3 "Недоимка" | span=4 "Штрафы, пени ииные санкции"
"1" | span=4 "_____________________________________" | span=3 "-" | span=4 "-"
