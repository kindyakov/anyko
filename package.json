{
  "name": "anyko",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "agent:github": "bun scripts/agent-github.mjs",
    "api:catalog": "bun scripts/api-catalog.ts",
    "dev:web": "bun run --filter @anyko/web dev",
    "dev:api": "bun run --filter @anyko/api dev",
    "dev:worker": "bun run --filter @anyko/worker dev",
    "e2e:prepare": "bun tests/e2e/backend/prepare.ts",
    "e2e:backend": "bun tests/e2e/backend/start.ts",
    "test:e2e:config": "bun test tests/e2e/backend/config.test.ts",
    "test:e2e:integration": "bun test --timeout 120000 tests/e2e/backend/harness.integration.test.ts",
    "test:e2e": "bun run e2e:prepare && node node_modules/@playwright/test/cli.js test --config tests/e2e/playwright.config.ts",
    "verify": "bun run verify:fast && bun run test:worker:integration && bun run test:documents:integration && bun run test:access:integration && bun run test:works:integration && bun run test:idempotency:integration && bun run test:audit:integration && bun run build && bun run test:e2e:config && bun run test:e2e:integration && bun run test:e2e",
    "format:check": "bun fmt --check apps packages scripts tests .github package.json eslint.config.mjs knip.json .dependency-cruiser.cjs .jscpd.json",
    "lint": "node --max-old-space-size=8192 node_modules/eslint/bin/eslint.js apps packages tests",
    "typecheck": "bun run --filter '@anyko/*' typecheck && tsc -p tests/architecture/tsconfig.json && tsc -p scripts/tsconfig.json && tsc -p tests/integration/tsconfig.json && tsc -p tests/e2e/tsconfig.json",
    "boundaries": "depcruise --config .dependency-cruiser.cjs apps packages",
    "knip": "knip",
    "duplicates": "jscpd apps packages",
    "check:project": "bun scripts/check-project.mjs",
    "test:architecture": "bun test --timeout 30000 tests/architecture/boundaries.test.ts",
    "test:api": "bun run --filter @anyko/api test",
    "test:agent-github": "bun test tests/tooling/agent-github.test.mjs",
    "verify:fast": "bun run format:check && bun run typecheck && bun run lint && bun run boundaries && bun run test:architecture && bun run test:api && bun run test:agent-github && bun run test:mineru && bun run test:llm && bun run test:works && bun run test:idempotency && bun run test:connections && bun run test:composition && bun run test:web && bun run test:logger && bun run test:worker && bun run test:diagnostics && bun run test:local-logs && bun run knip && bun run check:project && bun run duplicates",
    "build": "bun run --filter @anyko/web build",
    "build:windows": "bun scripts/build-windows-portable.mjs",
    "build:windows:components": "bun scripts/build-windows-components.mjs",
    "build:windows:web": "bun scripts/build-windows-web.mjs",
    "build:windows:infrastructure": "bun scripts/stage-windows-infrastructure.mjs",
    "build:windows:migrator": "bun scripts/stage-windows-migrator.mjs",
    "build:windows:mineru": "bun scripts/stage-windows-mineru.mjs",
    "build:windows:release": "bun scripts/stage-windows-release.mjs",
    "smoke:windows:mineru": "bun scripts/smoke-windows-mineru.mjs",
    "smoke:windows:migrator": "bun scripts/smoke-windows-migrator.mjs",
    "smoke:windows:web": "bun scripts/smoke-windows-web.mjs",
    "smoke:windows:components": "bun scripts/smoke-windows-components.mjs",
    "test:logger": "bun run --filter @anyko/logger test",
    "test:worker": "bun run --filter @anyko/worker test && bun test packages/backend/src/platform/jobs/jobs.test.ts packages/backend/src/modules/processing/application/job-scope.test.ts packages/backend/src/workflows/document-ocr/jobs.test.ts",
    "test:worker:integration": "bun test --timeout 60000 apps/worker/tests/integration tests/integration/worker/job-host.test.ts",
    "test:idempotency": "bun test packages/backend/src/modules/idempotency/application/fingerprint.test.ts",
    "test:idempotency:integration": "bun test --timeout 60000 packages/backend/tests/integration/idempotency.test.ts",
    "test:audit:integration": "bun test --timeout 60000 packages/backend/tests/integration/audit.test.ts",
    "test:diagnostics": "python -B -m unittest discover -s tests/diagnostics -v",
    "test:local-logs": "bun test tests/tooling/run-local.test.mjs",
    "db:generate": "bun run --filter @anyko/database generate",
    "db:migrate": "bun run --filter @anyko/database migrate",
    "artifacts:migrate": "bun scripts/migrate-document-artifacts.ts",
    "documents:recover-writes": "bun scripts/recover-document-writes.ts",
    "test:processor": "bun scripts/test-processor.mjs",
    "access:provision-local": "bun scripts/provision-local.ts",
    "test:web": "bun run --filter @anyko/web test",
    "storage:prepare": "bun scripts/prepare-storage.ts",
    "dev": "bun --env-file=.env scripts/dev.mjs",
    "smoke:document": "bun scripts/smoke-document.ts",
    "test:access:integration": "bun test tests/integration/access.test.ts",
    "test:documents:integration": "bun test tests/integration/worker/documents.test.ts tests/integration/worker/document-deletion.test.ts",
    "test:mineru": "bun test packages/backend/src/modules/documents/infrastructure/mineru.test.ts packages/backend/src/modules/documents/application/source-format.test.ts",
    "llm:provision": "bun scripts/provision-llm.ts",
    "test:llm": "bun run --filter @anyko/llm test",
    "test:composition": "bun test packages/backend/tests/integration/composition.test.ts",
    "test:works": "bun test packages/backend/src/modules/facts/facts.test.ts packages/backend/src/modules/facts/application/accept-run-candidates.test.ts packages/backend/tests/templates.test.ts packages/backend/src/modules/agents/infrastructure/vision-retry.test.ts packages/backend/src/modules/agents/application/session.test.ts packages/backend/src/platform/ids.test.ts packages/backend/src/modules/access/scope.test.ts packages/backend/src/modules/access/roles.test.ts packages/backend/src/modules/works/application/create-work.test.ts packages/backend/src/modules/documents/application/commands.test.ts",
    "test:works:integration": "bun test --timeout 60000 tests/integration/worker/works.test.ts packages/backend/tests/integration/vision-retry.test.ts packages/backend/tests/integration/session-agent.test.ts packages/backend/tests/integration/lock-pool.test.ts packages/backend/tests/integration/rights.test.ts packages/backend/tests/integration/unit-of-work.test.ts packages/backend/tests/integration/run-attempt.test.ts",
    "format": "bun fmt apps packages scripts tests .github package.json eslint.config.mjs knip.json .dependency-cruiser.cjs .jscpd.json",
    "hooks:install": "bun scripts/install-format-hook.mjs",
    "test:connections": "bun test packages/backend/src/modules/connections/application/commands.test.ts"
  },
  "devDependencies": {
    "@anyko/backend": "workspace:*",
    "@anyko/contracts": "workspace:*",
    "@anyko/database": "workspace:*",
    "@anyko/eslint-config": "workspace:*",
    "@anyko/llm": "workspace:*",
    "@anyko/logger": "workspace:*",
    "@anyko/typescript-config": "workspace:*",
    "@anyko/worker": "workspace:*",
    "@aws-sdk/client-s3": "3.1162.0",
    "@better-auth/prisma-adapter": "1.7.17",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@mastra/pg": "1.35.0",
    "@next/eslint-plugin-next": "16.4.5",
    "@playwright/test": "1.65.1",
    "@types/bun": "1.4.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "better-auth": "1.7.17",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-testing-library": "7.16.2",
    "fflate": "0.8.3",
    "ioredis": "6.0.0",
    "jscpd": "5.4.2",
    "knip": "6.44.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "zod": "4.6.7"
  },
  "packageManager": "bun@1.4.4"
}
