{
  "name": "anyko",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "agent:github": "bun scripts/agent-github.mjs",
    "dev:web": "bun run --filter @anyko/web dev",
    "dev:api": "bun run --filter @anyko/api dev",
    "dev:worker": "bun run --filter @anyko/worker dev",
    "format:check": "bun fmt --check apps packages scripts tests .github package.json eslint.config.mjs knip.json .dependency-cruiser.cjs .jscpd.json",
    "lint": "eslint apps packages tests",
    "typecheck": "bun run --filter '@anyko/*' typecheck && tsc -p tests/architecture/tsconfig.json && tsc -p scripts/tsconfig.json && tsc -p tests/integration/tsconfig.json",
    "boundaries": "depcruise --config .dependency-cruiser.cjs apps packages",
    "knip": "knip",
    "duplicates": "jscpd apps packages",
    "check:project": "bun scripts/check-project.mjs",
    "test:architecture": "bun test --timeout 30000 tests/architecture/boundaries.test.ts",
    "test:api": "bun run --filter @anyko/api test",
    "test:agent-github": "bun test tests/tooling/agent-github.test.mjs",
    "verify:fast": "bun run format:check && bun run typecheck && bun run lint && bun run boundaries && bun run test:architecture && bun run test:api && bun run test:agent-github && bun run test:mineru && bun run test:llm && bun run test:works && bun run test:web && bun run test:logger && bun run test:worker && bun run test:diagnostics && bun run test:local-logs && bun run knip && bun run check:project && bun run duplicates",
    "build": "bun run --filter @anyko/web build",
    "build:windows": "bun scripts/build-windows-portable.mjs",
    "build:windows:components": "bun scripts/build-windows-components.mjs",
    "build:windows:web": "bun scripts/build-windows-web.mjs",
    "build:windows:infrastructure": "bun scripts/stage-windows-infrastructure.mjs",
    "build:windows:migrator": "bun scripts/stage-windows-migrator.mjs",
    "build:windows:mineru": "bun scripts/stage-windows-mineru.mjs",
    "build:windows:release": "bun scripts/stage-windows-release.mjs",
    "smoke:windows:mineru": "bun scripts/smoke-windows-mineru.mjs",
    "smoke:windows:migrator": "bun scripts/smoke-windows-migrator.mjs",
    "smoke:windows:web": "bun scripts/smoke-windows-web.mjs",
    "smoke:windows:components": "bun scripts/smoke-windows-components.mjs",
    "test:logger": "bun run --filter @anyko/logger test",
    "test:worker": "bun run --filter @anyko/worker test",
    "test:worker:integration": "bun test packages/backend/tests/integration/diagnostic-worker.test.ts",
    "test:diagnostics": "python -B -m unittest discover -s tests/diagnostics -v",
    "test:local-logs": "bun test tests/tooling/run-local.test.mjs",
    "db:generate": "bun run --filter @anyko/database generate",
    "db:migrate": "bun run --filter @anyko/database migrate",
    "artifacts:migrate": "bun scripts/migrate-document-artifacts.ts",
    "documents:recover-writes": "bun scripts/recover-document-writes.ts",
    "test:processor": "bun scripts/test-processor.mjs",
    "access:provision-local": "bun scripts/provision-local.ts",
    "test:web": "bun run --filter @anyko/web test",
    "storage:prepare": "bun scripts/prepare-storage.ts",
    "dev": "bun --env-file=.env scripts/dev.mjs",
    "smoke:document": "bun scripts/smoke-document.ts",
    "test:access:integration": "bun test tests/integration/access.test.ts",
    "test:documents:integration": "bun test packages/backend/tests/integration/documents.test.ts packages/backend/tests/integration/document-deletion.test.ts",
    "test:mineru": "bun test packages/backend/src/modules/documents/infrastructure/mineru.test.ts packages/backend/src/modules/documents/application/source-format.test.ts",
    "llm:provision": "bun scripts/provision-llm.ts",
    "test:llm": "bun run --filter @anyko/llm test",
    "test:works": "bun test packages/backend/src/modules/facts/facts.test.ts packages/backend/tests/templates.test.ts packages/backend/src/modules/agents/infrastructure/vision-retry.test.ts packages/backend/src/modules/agents/session.test.ts",
    "test:works:integration": "bun test --timeout 60000 packages/backend/tests/integration/works.test.ts packages/backend/tests/integration/vision-retry.test.ts packages/backend/tests/integration/session-agent.test.ts",
    "format": "bun fmt apps packages scripts tests .github package.json eslint.config.mjs knip.json .dependency-cruiser.cjs .jscpd.json",
    "hooks:install": "bun scripts/install-format-hook.mjs"
  },
  "devDependencies": {
    "@anyko/backend": "workspace:*",
    "@anyko/contracts": "workspace:*",
    "@anyko/database": "workspace:*",
    "@anyko/eslint-config": "workspace:*",
    "@anyko/logger": "workspace:*",
    "@anyko/typescript-config": "workspace:*",
    "@aws-sdk/client-s3": "3.1162.0",
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "jscpd": "5.4.2",
    "knip": "6.44.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "zod": "4.6.7"
  },
  "packageManager": "bun@1.4.4"
}
