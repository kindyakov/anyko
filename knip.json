{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreBinaries": ["dev"],
  "ignore": ["work/**"],
  "workspaces": {
    ".": { "entry": ["tests/architecture/**/*.test.ts"] },
    "packages/backend": {
      "entry": ["src/runtime/*.integration.test.ts", "src/modules/**/*.test.ts"]
    },
    "packages/database": {
      "ignore": ["generated/**"],
      "ignoreDependencies": ["@prisma/client", "@prisma/client-runtime-utils"]
    }
  }
}
