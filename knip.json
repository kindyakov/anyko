{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreBinaries": ["dev"],
  "ignore": ["work/**"],
  "workspaces": {
    ".": {
      "entry": [
        "tests/architecture/**/*.test.ts",
        "tests/processor/create-junction.mjs",
        "infra/windows/bootstrap.mjs",
        "scripts/restore-windows-web-links.mjs",
        "scripts/stage-windows-web.mjs"
      ]
    },
    "packages/backend": {
      "entry": [
        "tests/integration/*.test.ts",
        "tests/portable-template-probe.ts",
        "tests/templates.test.ts",
        "src/modules/**/*.test.ts"
      ]
    },
    "packages/database": {
      "ignore": ["generated/**"],
      "ignoreDependencies": ["@prisma/client", "@prisma/client-runtime-utils"]
    }
  }
}
